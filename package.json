{
	"name": "wscommerce",
	"private": true,
	"description": "Websolutions Commerce — native EmDash commerce on Cloudflare Workers",
	"homepage": "https://github.com/wsagency/wscommerce#readme",
	"bugs": {
		"url": "https://github.com/wsagency/wscommerce/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wsagency/wscommerce.git"
	},
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/klukacin"
	},
	"type": "module",
	"scripts": {
		"lint": "oxlint && depcruise --config .dependency-cruiser.cjs packages",
		"typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
		"test": "vitest run",
		"test:pg": "vitest run $(./scripts/pg-test-files.sh)",
		"test:d1": "pnpm -C packages/store-emdash test:d1",
		"test:e2e": "playwright test",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"build": "pnpm -r build",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"dependency-cruiser": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.16"
	},
	"packageManager": "pnpm@11.10.0"
}
