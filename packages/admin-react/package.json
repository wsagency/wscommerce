{
	"name": "@otta-sh/admin-react",
	"version": "0.0.1",
	"description": "WSCommerce React admin console — the `otta-console` native-format EmDash descriptor (ADR-0014). Zero capabilities, zero allowedHosts; reaches commerce only through the existing authenticated `otta` admin routes.",
	"homepage": "https://github.com/wsagency/wscommerce#readme",
	"bugs": {
		"url": "https://github.com/wsagency/wscommerce/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wsagency/wscommerce.git",
		"directory": "packages/admin-react"
	},
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/klukacin"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./admin": {
				"types": "./dist/admin.d.mts",
				"default": "./dist/admin.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@otta-sh/admin-presentation": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"emdash": "1.0.1",
		"happy-dom": "^20.11.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"emdash": ">=1.0.1 <2.0.0",
		"react": "^19.2.4"
	},
	"engines": {
		"node": ">=22.16"
	}
}
