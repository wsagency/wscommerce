{
	"name": "@otta-sh/domain",
	"version": "0.0.1",
	"description": "WSCommerce commerce domain — pure ports, use-cases, and branded types. No IO.",
	"homepage": "https://github.com/wsagency/wscommerce#readme",
	"bugs": {
		"url": "https://github.com/wsagency/wscommerce/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wsagency/wscommerce.git",
		"directory": "packages/domain"
	},
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/klukacin"
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./testing": {
				"types": "./dist/testing/index.d.mts",
				"default": "./dist/testing/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"fast-check": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
