{
	"name": "@emdash-commerce/invoicing",
	"version": "0.1.0",
	"description": "Immutable commerce invoice snapshots, durable jobs, Solo and e-racuni adapters",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./types": {
				"types": "./dist/types.d.mts",
				"default": "./dist/types.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@otta-sh/domain": "workspace:*",
		"@otta-sh/store-emdash": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
